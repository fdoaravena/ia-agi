services:
  redis:
    # Esta imagen incluye RediSearch y RedisJSON necesarios para búsqueda vectorial
    image: redis/redis-stack-server:7.2.0-v13 
    container_name: redis_vector_db
    restart: always
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    environment:
      - REDIS_ARGS=--requirepass misma_contraseña_del_env --appendonly yes
    networks:
      - rag_network

volumes:
  redis_data:

networks:
  rag_network:
    driver: bridge